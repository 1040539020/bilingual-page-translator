{
  "name": "bilingual-page-translator",
  "version": "0.1.0",
  "private": true,
  "description": "Manifest V3 Chrome extension for bilingual web page translation.",
  "scripts": {
    "clean": "rimraf dist release",
    "clean:chrome": "rimraf dist/chrome",
    "clean:edge": "rimraf dist/edge",
    "clean:firefox": "rimraf dist/firefox",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:chrome",
    "build:chrome": "npm run clean:chrome && cross-env TARGET_BROWSER=chrome webpack --mode production",
    "build:edge": "npm run clean:edge && cross-env TARGET_BROWSER=edge webpack --mode production",
    "build:firefox": "npm run clean:firefox && cross-env TARGET_BROWSER=firefox webpack --mode production",
    "dev": "webpack --mode development --watch",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js tests/integration",
    "test:e2e": "playwright test",
    "package:zip": "node scripts/package-extension.js zip",
    "package:crx": "node scripts/package-extension.js crx",
    "ci": "npm run typecheck && npm test && npm run build:chrome"
  },
  "dependencies": {
    "@types/chrome": "^0.0.268",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "archiver": "^7.0.1",
    "babel-jest": "^29.7.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.9.0",
    "playwright": "^1.47.0",
    "rimraf": "^5.0.7",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4"
  }
}
